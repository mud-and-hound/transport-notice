# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
DB_HOST=localhost
DB_PORT=3306
DB_NAME=transport_notice
DB_USER=timemud
DB_PASSWORD=ใส่รหัสผ่านตรงนี้
APP_PORT=8606
# รหัสเข้าใช้งานเมื่อเปิดผ่านอินเทอร์เน็ต (GitHub Pages / Cloudflare Tunnel) — ว่าง = ไม่ต้องใช้รหัส ใช้ได้เลย
ACCESS_KEY=

# อีเมลสรุปรายวัน — ดู scripts/send_daily_mail.py (ห้ามใส่อีเมลผู้รับจริงในไฟล์นี้ เพราะ repo เป็น Public)
MAIL_MODE=test
MAIL_TEST_TO=you@example.com
MAIL_TO=receiver1@example.com,receiver2@example.com
# ส่งไม่สำเร็จหลังรอบสุดท้าย (00:30) → แจ้งเตือน
MAIL_ALERT_TO=it@example.com
MAIL_FROM=
MAIL_SENDER=graph
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
